{
  "name": "client-progress-report-tracker",
  "version": "1.0.0",
  "description": "A small desktop app for tracking client progress report due dates.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.example.tokenexpirationtracker",
    "productName": "Client Progress Report Tracker",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "date-utils.js"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities"
    }
  }
}
